%% methods_timeline.mmd — iteration timeline (M-1b) for amorphous Pt(P)
%% Source of truth for Fig. in sections/03_methods.tex (Iteration timeline).
%% Mirrors the mermaid in CLAIMS.md M-1b.
%% Render: npx @mermaid-js/mermaid-cli -i methods_timeline.mmd -o ../analysis/figures/methods_timeline.png
flowchart LR
    Init["Init (i = 0)"]
    Dec{"Iteration i"}

    subgraph BE["Biased Exploration"]
        direction TB
        P1["<b>Phase I</b><br/>Amorphous: N = 10"]
        P2["<b>Phase II</b><br/>Amorphous: N=5 | Rattle: N=5"]
        P3["<b>Phase III</b><br/>Rattle: N=5 | Permute: N=5"]
    end

    GPR["GPR Surrogate<br/>Optimization"]
    Eval["LCB Select M →<br/>DFT Evaluate M"]
    DB[(Database)]

    Init --> Dec
    
    Dec -->|i < 10| P1
    Dec -->|10 ≤ i < 25| P2
    Dec -->|i ≥ 25| P3

    P1 --> Eval
    P2 --> GPR
    P3 --> GPR

    GPR --> Eval --> DB
    DB -->|i = i + 1| Dec

    style BE fill:#f4f4f5,stroke:#71717a,stroke-width:1px,color:#18181b

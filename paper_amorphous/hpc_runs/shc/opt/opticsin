*** PHOTO FREQUENCY ***************
Range in photo energy or set w_low=w_top=0.0 for electric/Hall condictivity
  w_low:0.0                             !in eV
  w_top:0.0                             !in eV 
  w_del:1.0                             !in eV  w_del.gt.0
*** OPTICAL CAL. ******************
Intraband:F, Method:P                   !T/F, Empirical/Plasma
  1/tau:0.272116                        !1/relaxation time, in eV
  ocp_function:N, width:0.0272116       !Fermi/Gauss/None, in eV
  Emprical method
    sigma:4.207                         !in eV
Interband:T, Method:C                   !T/F, Complex/Sharp with KK
  e_bound:60.0                          !bound of unoccupied states, in eV
  ocp_function:F, width:0.0272116       !Fermi/None, in eV
  Complex method    
    1/tau:0.272116                      !1/relaxation time in eV
  Sharp with Kramers-Kronig method      !assumed sharp limit 1/tau=0
    e_del:0.01                          !interval for KK integral, in eV
    e_top:60.0                          !upper bound for KK integral, in eV
Magneto-optics:F                        !T/F, needed intra or/and inter-bands
Core-Valence:F, Method:S                !Sharp (XAS/XMCD)
  e_bound:60.0                          !bound of unoccupied states, in eV
  distribution:L, width:0.0272116       !Gauss/Lorentz/None, in eV
  states
    atom:1                              !atom,       all when <0
    core:4                              !core state, all when <0
*** NUMERICAL OPTIONS *************
Fermi Energy
  smearing:G, width:0.001               !Gauss/Fermi/None, in htr
Zero energy:0.00001                     !zero between e_u and e_o, in htr
Delta func:G, width:0.001               !Gauss/None in htr (inter_sgmss.f)
*** CAL. OPTIONS ******************
Zval shift:F                            !T/F
  deviation:0.00                        !(z-z0) in electron number
Fermi energy shift:F                    !T/F
  deviation:0.10                        !(e-ef) in eV
K-dispersion:F                          !T/F
  ef: 0.299606900212                    !in htr
  photo frequency:0.0                   !in eV
Band slice:F                            !T/F for occ-unocc transiton
  degeneracy:F, e_interval:0.00001      !T:averaged degenerated atates, in eV
  index:25 26                           !bands
Berry curvature:F                       !T/F
  degeneracy:F, e_interval:0.00001      !T:averaged degenerated atates, in eV
  index:25 -1                           !band, contributed bands(all when <0)



@article{paisley2011,
  title = {Surfactant-Enabled Epitaxy through Control of Growth Mode with Chemical Boundary Conditions},
  author = {Paisley, Elizabeth A. and Losego, Mark D. and Gaddy, Benjamin E. and Tweedie, James S. and Collazo, Ram{\'o}n and Sitar, Zlatko and Irving, Douglas L. and Maria, Jon-Paul},
  year = 2011,

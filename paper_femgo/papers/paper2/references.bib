@article{scheike2021,
    author = {Scheike, Thomas and Xiang, Qingyi and Wen, Zhenchao and Sukegawa, Hiroaki and Ohkubo, Tadakatsu and Hono, Kazuhiro and Mitani, Seiji},
    title = {Exceeding 400\% tunnel magnetoresistance at room temperature in epitaxial Fe/MgO/Fe(001) spin-valve-type magnetic tunnel junctions},
    journal = {Applied Physics Letters},
    volume = {118},
    number = {4},
    pages = {042411},
    year = {2021},
    month = {01},
    abstract = {Giant tunnel magnetoresistance (TMR) ratios of 417\% at room temperature (RT) and 914\% at 3 K were demonstrated in epitaxial Fe/MgO/Fe(001) exchange-biased spin-valve magnetic tunnel junctions (MTJs) by tuning growth conditions for each layer, combining sputter deposition for the Fe layers, electron-beam evaporation of the MgO barrier, and barrier interface tuning. Clear TMR oscillation as a function of the MgO thickness with a large peak-to-valley difference of ∼80\% was observed when the layers were grown on a highly (001)-oriented Cr buffer layer. Specific features of the observed MTJs are symmetric differential conductance (dI/dV) spectra for the bias polarity and plateau-like deep local minima in dI/dV (parallel configuration) at |V| = 0.2–0.5 V. At 3 K, fine structures with two dips emerge in the plateau-like dI/dV, reflecting highly coherent tunneling through the Fe/MgO/Fe. We also observed a 496\% TMR ratio at RT by a 2.24 nm-thick-CoFe insertion at the bottom-Fe/MgO interface.},
    issn = {0003-6951},
    doi = {10.1063/5.0037972},
    url = {https://doi.org/10.1063/5.0037972},
    eprint = {\url{https://pubs.aip.org/aip/apl/article-pdf/doi/10.1063/5.0037972/20717896/042411_1_5.0037972.pdf}},
}






output/
*.pyc

# The training DBs are INPUTS (not regenerable) and MUST be committed, despite
# the repo's global `*.db` and `paper_femgo/.gitignore` `data/` rules. These
# negations re-include them (mirrors hpc_runs/2dlandau / paper_amorphous/...).
!data/
!data/femgo/
!data/femgo/seed_*/
!data/femgo/seed_*/1_db/
!data/femgo/seed_*/1_db/*.db
